DATABASE_URL=
# Generate with `npm run hash-password`. It prints a version with dollar
# signs pre-escaped (\$) for this file — Next.js expands unescaped $VAR
# references in .env files, which would otherwise silently mangle the hash.
# Use the RAW (unescaped) hash when entering this in Vercel's dashboard.
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=
# Optional: absolute site URL used in robots.txt/sitemap. Defaults to localhost.
NEXT_PUBLIC_SITE_URL=
